# Copy to .env and fill in real values:  cp .env.example .env
# .env is git-ignored. Never commit real secrets.

# --- application
# development | test | production
ENVIRONMENT=development
APP_NAME=BudgetAnalytics
VERSION=0.1.0
API_PREFIX=/api/v1
DEBUG=false
# Empty = enabled everywhere except production.
DOCS_ENABLED=

# --- database
# Local run (uvicorn on the host, Postgres from docker compose):
DATABASE_URL=postgresql+asyncpg://budget:change-me-db-password@localhost:5432/budget
# Logs every SQL statement WITH parameters (PII). Never enable in production.
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Used by docker compose for the Postgres container and the api/migrate
# services (compose builds DATABASE_URL for them from these values).
POSTGRES_USER=budget
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=budget
# Host port for the compose Postgres (127.0.0.1 only). If you change it,
# change the port in DATABASE_URL / TEST_DATABASE_URL above/below to match.
POSTGRES_HOST_PORT=5432

# --- security
# Production requires >= 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# HS256 | HS384 | HS512
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# JSON list of allowed browser origins; "*" is rejected in production.
CORS_ORIGINS=["http://localhost:3000"]
MAX_REQUEST_BYTES=1048576

# --- rate limiting
# memory = per process (development only); production requires redis.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=memory
# REDIS_URL=redis://:password@redis:6379/0
# Legacy (deprecated) endpoints; empty = enabled except in production.
ENABLE_LEGACY_API=

# --- logging
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# true = one JSON object per line; false = readable console lines.
LOG_JSON=false

# --- tests (only for pytest integration tests; the DB is TRUNCATED after each test)
# TEST_DATABASE_URL=postgresql+asyncpg://budget:change-me-db-password@localhost:5432/budget_test

# --- statement import
IMPORT_MAX_FILE_BYTES=5242880
IMPORT_MAX_ROWS=5000
IMPORT_PREVIEW_TTL_HOURS=24

# --- AI advisor
# none = deterministic rule-based insights only (no external calls).
# openai = OpenAI Chat Completions (or any compatible endpoint via OPENAI_BASE_URL).
AI_PROVIDER=none
AI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...           # required when AI_PROVIDER=openai; never commit it
# OPENAI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=1500
# Prices of your model (USD per 1M tokens) — needed for cost accounting and cost limits.
# AI_INPUT_PRICE_PER_1M_TOKENS_USD=
# AI_OUTPUT_PRICE_PER_1M_TOKENS_USD=
AI_DAILY_TOKEN_LIMIT_PER_USER=50000
# AI_DAILY_COST_LIMIT_PER_USER_USD=0.50
# AI_MONTHLY_COST_LIMIT_TOTAL_USD=100
