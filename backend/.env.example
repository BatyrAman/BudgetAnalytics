# Скопируйте в backend/.env и заполните. Файл .env не коммитится.

# --- application ---
APP_NAME="Budget Analytics"
ENVIRONMENT=development          # development | test | production
DEBUG=false
API_PREFIX=/api/v1

# --- database (async driver обязателен) ---
DATABASE_URL=postgresql+asyncpg://budget:budget@localhost:5432/budget
DB_ECHO=false
STARTUP_CHECKS=true              # проверять доступность БД и alembic head при старте

# --- auth ---
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
REFRESH_COOKIE_SECURE=false      # true в production (только HTTPS)
REFRESH_COOKIE_SAMESITE=strict
REFRESH_TOKEN_IN_BODY=false      # legacy-режим для не-браузерных клиентов

# --- CORS: явный список origin'ов фронтенда через запятую ("*" запрещён) ---
CORS_ORIGINS=http://localhost:3000

# --- logging ---
LOG_LEVEL=INFO
LOG_JSON=false

# --- uploads / rate limiting ---
MAX_UPLOAD_SIZE_MB=10
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_PER_MINUTE=10
UPLOAD_RATE_LIMIT_PER_MINUTE=20

# --- background tasks ---
REDIS_URL=redis://localhost:6379/0   # только для ARQ worker
BANK_PRODUCTS_FILE=                  # JSON с условиями банков для update_bank_products

# --- AI (LLM не подключён; provider "disabled" отвечает 503) ---
AI_PROVIDER=disabled
