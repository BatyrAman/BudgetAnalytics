# Settings for the root compose.yaml (full stack). Copy and fill in:
#   cp .env.example .env
# .env is git-ignored. Never commit real secrets.
#
# Passwords go into connection URLs: use URL-safe values (letters, digits, - and _), e.g.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# --- required
POSTGRES_PASSWORD=change-me-db-password
REDIS_PASSWORD=change-me-redis-password
# At least 32 random characters.
SECRET_KEY=change-me-to-a-long-random-value

# --- database (PostgreSQL applies USER/PASSWORD/DB only when the volume is first created;
# an existing budgetanalytics_pgdata volume keeps its original password)
POSTGRES_USER=budget
POSTGRES_DB=budget

# --- application
# development: /docs enabled. Production is deployed with backend/docker-compose.prod.yml.
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=true
# none = rule-based advisor, no external calls. openai requires OPENAI_API_KEY.
AI_PROVIDER=none
# OPENAI_API_KEY=

# --- host ports (bound to 127.0.0.1 only)
FRONTEND_HOST_PORT=3000
API_HOST_PORT=8000
# Used only with compose.dev-ports.yaml:
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# --- internal network (change both together if the subnet overlaps a local network)
COMPOSE_SUBNET=172.31.250.0/24
FRONTEND_IPV4=172.31.250.10
